.godot/
*.import
export/
build/
game/bin/*
!game/bin/.gitkeep
game/.godot/
# Local project-setting overrides (screenshot sizes); never committed.
game/override.cfg
# Copied in by CMake and tools/release/game-files.py
game/CREDITS.md
game/LICENSE.txt
game/THIRD-PARTY-NOTICES.txt
game/SOURCE.txt
site/_site/
__pycache__/
.venv/
bench-out/
dist/
# Generated by tools/assets/gen_theme_textures.py in the build (CMake target
# `textures`, CI action .github/actions/textures); never committed.
# Hand-made textures elsewhere under game/assets/textures/ are still tracked.
game/assets/textures/*/T_*.png
game/assets/textures/*/hi/T_*.png
game/assets/textures/*/grade/T_*.png
game/assets/textures/*/.inputs
# Lightmaps baked by tools/assets/bake_lightmaps.cmake in the build (CI action
# .github/actions/lightmaps); never committed. Godot's UV2 unwrap cache too.
game/assets/models/*/backdrop/*.lmbake
game/assets/models/*/backdrop/*.exr
game/assets/models/*/backdrop/*.exr.import
game/assets/models/*/backdrop/.lightmap-inputs
*.unwrap_cache
# Static theme meshes carry their import settings (lightmap UV2) in git.
!game/assets/models/*/board/*.obj.import
!game/assets/models/*/backdrop/*.obj.import
# Generated by tools/assets/fx/gen_fire.py in the build (CMake target
# `textures`, CI action .github/actions/textures); never committed.
game/assets/textures/*/fx/T_*.png
game/assets/textures/*/fx/hi/T_*.png
game/assets/textures/*/fx/.inputs
# CMake build folders (build/, build-ext/, build-asan/ ...).
build-*/
