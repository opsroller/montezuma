[gd_scene format=3]
; SPDX-License-Identifier: GPL-2.0-or-later
; Copyright (C) 2026 Charles (opsroller) and Montezuma contributors
; Lit stage for the hero, icon and lockup stills: the temple on a paved studio floor,
; late-afternoon sun from the upper left, and a LightmapGI (path-traced bounce light and
; contact shading; bake output stage_studio.lmbake is generated and not committed).
; Render all stills in one launch (see render_all.tscn):
;   python3 design/keyart/gen/build.py
;   godot --editor --path design/keyart -- --bake-lightmaps=res://stage_studio.tscn,res://stage_plaza.tscn
;   godot --path design/keyart --write-movie /tmp/keyart/all.png --fixed-fps 1 --quit-after 16
;   python3 design/keyart/gen/finish.py /tmp/keyart/all00000015.png


[ext_resource type="PackedScene" path="res://temple.tscn" id="temple"]
[ext_resource type="Mesh" path="res://meshes/ground_studio.obj" id="ground"]
[ext_resource type="LightmapGIData" path="res://stage_studio.lmbake" id="lm"]
[ext_resource type="Texture2D" path="res://textures/paving_albedo.png" id="pa"]
[ext_resource type="Texture2D" path="res://textures/paving_normal.png" id="pn"]
[ext_resource type="Texture2D" path="res://textures/paving_orm.png" id="po"]
[ext_resource type="Texture2D" path="res://textures/sky_golden.png" id="sky"]

[sub_resource type="PanoramaSkyMaterial" id="sky_mat"]
panorama = ExtResource("sky")
energy_multiplier = 1.3

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")
radiance_size = 4

[sub_resource type="FastNoiseLite" id="n_macro"]
frequency = 0.004
fractal_octaves = 5

[sub_resource type="Gradient" id="g_macro"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.55, 0.52, 0.49, 1, 1.12, 1.06, 1.0, 1)

[sub_resource type="NoiseTexture2D" id="t_macro"]
width = 1024
height = 1024
seamless = true
noise = SubResource("n_macro")
color_ramp = SubResource("g_macro")

[sub_resource type="StandardMaterial3D" id="m_paving"]
albedo_color = Color(0.62, 0.6, 0.58, 1)
albedo_texture = ExtResource("pa")
roughness_texture = ExtResource("po")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("pn")
ao_enabled = true
ao_texture = ExtResource("po")
detail_enabled = true
detail_blend_mode = 3
detail_uv_layer = 1
detail_albedo = SubResource("t_macro")
uv2_scale = Vector3(0.01, 0.01, 0.01)
uv2_triplanar = true
uv2_world_triplanar = true
texture_filter = 5
distance_fade_mode = 2
distance_fade_min_distance = 330.0
distance_fade_max_distance = 255.0

[node name="StageStudio" type="Node3D"]

[node name="Temple" parent="." instance=ExtResource("temple")]

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = ExtResource("ground")
surface_material_override/0 = SubResource("m_paving")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.74314, 0.16188, -0.64925, -0.00000, 0.97030, 0.24192, 0.66913, -0.17978, 0.72107, -0.64925, 50.24192, 0.72107)
light_color = Color(1, 0.78, 0.55, 1)
light_energy = 4.6
light_angular_distance = 0.6
light_volumetric_fog_energy = 1.0
light_bake_mode = 2
shadow_enabled = true
shadow_blur = 0.5
directional_shadow_max_distance = 700.0

[node name="Lightmap" type="LightmapGI" parent="."]
quality = 3
bounces = 4
bounce_indirect_energy = 1.4
use_denoiser = true
denoiser_strength = 0.1
use_texture_for_bounces = true
interior = false
environment_mode = 2
environment_custom_sky = SubResource("sky")
environment_custom_energy = 1.0
generate_probes_subdiv = 2
max_texture_size = 16384
light_data = ExtResource("lm")
