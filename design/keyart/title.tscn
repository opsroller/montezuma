surface_material_override/0 = SubResource("m_gold_face")
surface_material_override/1 = SubResource("m_gold_bevel")
surface_material_override/2 = SubResource("m_gold_side")

[node name="ShadowCatcher" type="MeshInstance3D" parent="."]
