[gd_scene format=3]
; SPDX-License-Identifier: GPL-2.0-or-later
; Copyright (C) 2026 Charles (opsroller) and Montezuma contributors
; Title wordmark: the drawn Montezuma's wordmark (design/logo/wordmark.svg) as a solid,
; extruded 0.12 of the cap height with a 45-degree chamfer (gen/wordmark.py), freestanding in
; burnished pale high-karat cast gold (silver-rich: pale yellow, not reddish; metallic; polished
; faces and bevels, slightly rougher sides). A shadow-catcher floor gives a soft contact shadow
; on the transparent background. Output renders/title-wordmark.png, 1920x600 (rendered 3840x1200).
; Render all stills in one launch (see render_all.tscn):
;   python3 design/keyart/gen/build.py
;   godot --editor --path design/keyart -- --bake-lightmaps=res://stage_studio.tscn,res://stage_plaza.tscn
;   godot --path design/keyart --write-movie /tmp/keyart/all.png --fixed-fps 1 --quit-after 16
;   python3 design/keyart/gen/finish.py /tmp/keyart/all00000015.png


[ext_resource type="Mesh" path="res://meshes/wordmark.obj" id="wordmark"]
[ext_resource type="Texture2D" path="res://textures/title_env.png" id="sky"]

[sub_resource type="PanoramaSkyMaterial" id="sky_mat"]
panorama = ExtResource("sky")
energy_multiplier = 2.2

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")
radiance_size = 4

[sub_resource type="Gradient" id="g_grade"]
offsets = PackedFloat32Array(0, 0.25, 0.5, 0.75, 1)
colors = PackedColorArray(0.0, 0.006, 0.022, 1, 0.24, 0.25, 0.265, 1, 0.505, 0.5, 0.485, 1, 0.765, 0.75, 0.72, 1, 1, 0.99, 0.95, 1)

[sub_resource type="GradientTexture1D" id="t_grade"]
gradient = SubResource("g_grade")
width = 256

[sub_resource type="Environment" id="env"]
background_mode = 0
background_color = Color(0, 0, 0, 1)
sky = SubResource("sky")
ambient_light_source = 3
reflected_light_source = 2
tonemap_mode = 2
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.2
ssil_enabled = true
ssil_intensity = 0.5
glow_enabled = true
glow_intensity = 0.35
glow_hdr_threshold = 1.5
adjustment_enabled = true
adjustment_saturation = 1.06
adjustment_contrast = 1.06
adjustment_color_correction = SubResource("t_grade")

[sub_resource type="FastNoiseLite" id="n_burnish"]
frequency = 0.08
fractal_octaves = 4

[sub_resource type="Gradient" id="g_burnish"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.10, 0.10, 0.10, 1, 0.22, 0.22, 0.22, 1)

[sub_resource type="NoiseTexture2D" id="t_burnish"]
width = 512
height = 512
seamless = true
noise = SubResource("n_burnish")
color_ramp = SubResource("g_burnish")

[sub_resource type="StandardMaterial3D" id="m_gold_face"]
albedo_color = Color(1.0, 0.92, 0.7, 1)
metallic = 1.0
roughness = 1.0
roughness_texture = SubResource("t_burnish")
uv1_scale = Vector3(2, 2, 2)
uv1_triplanar = true

[sub_resource type="StandardMaterial3D" id="m_gold_bevel"]
albedo_color = Color(1.0, 0.93, 0.72, 1)
metallic = 1.0
roughness = 0.09

[sub_resource type="StandardMaterial3D" id="m_gold_side"]
albedo_color = Color(0.97, 0.88, 0.66, 1)
metallic = 1.0
roughness = 0.3

[sub_resource type="PlaneMesh" id="floor"]
size = Vector2(30, 12)

[sub_resource type="StandardMaterial3D" id="m_catcher"]
shadow_to_opacity = true
albedo_color = Color(0.05, 0.035, 0.025, 1)
roughness = 1.0

[node name="Title" type="Node3D"]

[node name="Wordmark" type="MeshInstance3D" parent="."]
