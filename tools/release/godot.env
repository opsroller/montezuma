#
# The Godot release the build pipeline exports with: 4.8 beta 1, chosen
# for its Metal performance work (see docs/explanation/about-the-engine-version.md).
# Pre-releases are published on godotengine/godot-builds, not
# godotengine/godot. Checksums are from
# https://github.com/godotengine/godot-builds/releases/download/4.8-beta1/SHA512-SUMS.txt
# (engine commit 4d10419cacd6d3009976e8f9fd3abd970fd58018).
GODOT_VERSION=4.8-beta1
GODOT_TAG=4.8-beta1
GODOT_RELEASES_URL=https://github.com/godotengine/godot-builds/releases/download
GODOT_TEMPLATES_DIR_NAME=4.8.beta1
GODOT_EDITOR_LINUX_ZIP=Godot_v4.8-beta1_linux.x86_64.zip
GODOT_EDITOR_LINUX_SHA512=aee4cbf3c5f86eee875c0f2f77cc9d816a3fbb220774e6ffc95fd5a557a6c5ec917f2b6118c0aa2008bd10f4b2a021225dc78ba7b7c54745411e0f2721f70a67
GODOT_TEMPLATES_TPZ=Godot_v4.8-beta1_export_templates.tpz
# 4.8 beta 1's exporter packs the debug binaries into a universal macOS
# release export; fetch-godot.cmake swaps the variants in the installed
# macos.zip to undo that (tools/release/macos-template-swap.py). Set to 0
# for a Godot release that fixes the exporter.
GODOT_MACOS_SWAP_TEMPLATE_VARIANTS=1
GODOT_TEMPLATES_SHA512=fa53ad6883ae6c78ee9d2f8d14ca4d34852fa21c462d1f4b0f599138d7de40897cc058f15083a1fa80c7d4b7590b2222dea6f056be7b49e3a584eb64fc30b0b7

# Emscripten for the web build of the extension: the version Godot's
# official web export templates are built with. 4.8 has no branch in
# https://github.com/godotengine/build-containers yet; its betas build
# from main, whose Dockerfile.web sets EMSCRIPTEN_VERSION=6.0.12 since
# 2026-10-09 (before 4.8 beta 1). A side module built with another
# version may not load.
EMSDK_VERSION=6.0.12
