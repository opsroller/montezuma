# The Godot release the build pipeline exports with. Checksums are from
# https://github.com/godotengine/godot/releases/download/4.4.1-stable/SHA512-SUMS.txt
GODOT_VERSION=4.4.1
GODOT_TAG=4.4.1-stable
GODOT_TEMPLATES_DIR_NAME=4.4.1.stable
GODOT_EDITOR_LINUX_ZIP=Godot_v4.4.1-stable_linux.x86_64.zip
GODOT_EDITOR_LINUX_SHA512=ef4e76880a514257175544952c61191106fdef3095b909bafed9fcbeb230c3e5533920a0f3012882dd4bbde83028a67549825794e2d2c3cf76eba7918b71370e
GODOT_TEMPLATES_TPZ=Godot_v4.4.1-stable_export_templates.tpz
GODOT_TEMPLATES_SHA512=8f461c7d6e91a0fbabfc95b1e4ca70ff1732c6f2920956a16b086ec2a85b5f7e238baf4dbce60dcc5630fae3bcb9a1fa2ae2027b92cb495c02d082705715e441

# Emscripten for the web build of the extension: the version Godot's own
# web export templates are built with, from
# https://github.com/godotengine/godot/blob/4.4.1-stable/.github/workflows/web_builds.yml (EM_VERSION).
# A side module built with another version may not load.
EMSDK_VERSION=3.1.64
