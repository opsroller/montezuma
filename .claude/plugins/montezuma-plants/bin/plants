#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""`plants <step>` - the plant look-dev pipeline, as a bare command.

Files in a plugin's bin/ are on the Bash tool's PATH while the plugin is enabled,
so every step of this pipeline is one word with no path in front of it:

    plants all --species heliconia
    plants capture --scope rows
    plants check

The pipeline is tools/assets/lookdev.py in the project. This finds the project from
the working directory and hands the arguments straight to it, so there is one
implementation and this is only the way to reach it.
"""

import os
import subprocess
import sys
from pathlib import Path

PIPELINE = Path("tools/assets/lookdev.py")


def project_root():
    """The checkout this command was run inside, from git, not from a written path."""
    found = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=False,
    )
    if found.returncode == 0 and found.stdout.strip():
        root = Path(found.stdout.strip())
        if (root / PIPELINE).exists():
            return root
    # Fall back to CLAUDE_PROJECT_DIR, which the plugin environment sets.
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    if project and (Path(project) / PIPELINE).exists():
        return Path(project)
    sys.exit(f"error: {PIPELINE} not found. Run this inside the montezuma checkout.")


def main():
    root = project_root()
    return subprocess.run(
        [sys.executable, str(PIPELINE), *sys.argv[1:]], cwd=root, check=False
    ).returncode


if __name__ == "__main__":
    sys.exit(main())
