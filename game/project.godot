; Engine configuration file.
; SPDX-License-Identifier: GPL-2.0-or-later
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Montezuma's"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/load_shell_environment=true
run/main_scene.web="res://scenes/demo/intro_level.tscn"

[autoload]

GameAudio="*res://scenes/audio/game_audio.tscn"
UiRoot="*res://ui/ui_root.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=4
window/size/borderless=true
window/hdr/request_hdr_output=true
window/stretch/aspect="ignore"
window/handheld/orientation=6
window/vsync/vsync_mode=0

[internationalization]

locale/translations=PackedStringArray("res://ui/strings.en.translation")

[physics]

2d/run_on_separate_thread=true
3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true
jolt_physics_3d/queries/enable_ray_cast_face_index=true
jolt_physics_3d/limits/temporary_memory_buffer_size=64

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
driver/threads/thread_model=2
textures/vram_compression/import_etc2_astc=true
textures/lossless_compression/force_png=true
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=5
shader_compiler/shader_cache/strip_debug=true
reflections/reflection_atlas/reflection_count=8
global_illumination/voxel_gi/quality=1
textures/default_filters/anisotropic_filtering_level=4
camera/depth_of_field/depth_of_field_bokeh_quality=3
environment/ssao/quality=4
environment/ssil/quality=4
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
scaling_3d/mode=2
scaling_3d/mode.ios=4
scaling_3d/mode.macos=4
environment/glow/upscale_mode.mobile=1
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=true
vrs/mode=1
anti_aliasing/quality/msaa_3d.web=3
lights_and_shadows/directional_shadow/size.web=1024

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
