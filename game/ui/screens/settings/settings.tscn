[gd_scene format=3]
; SPDX-License-Identifier: GPL-2.0-or-later

[node name="SettingsScreen" type="SettingsScreen"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
screen_id = "settings"
default_focus = NodePath("%Music")

[node name="Backdrop" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScrimPanel"

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2

[node name="Heading" type="Label" parent="Center/Panel/Column"]
layout_mode = 2
text = "settings.title"
horizontal_alignment = 1
theme_type_variation = &"HeadingLabel"

[node name="Scroll" type="ScrollContainer" parent="Center/Panel/Column"]
layout_mode = 2
custom_minimum_size = Vector2(760, 430)
follow_focus = true
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Center/Panel/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MusicRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/MusicRow"]
layout_mode = 2
text = "settings.music"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="Music" type="HSlider" parent="Center/Panel/Column/Scroll/Rows/MusicRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)
max_value = 1.0
step = 0.05
size_flags_vertical = 4

[node name="SfxRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/SfxRow"]
layout_mode = 2
text = "settings.sfx"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="Sfx" type="HSlider" parent="Center/Panel/Column/Scroll/Rows/SfxRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)
max_value = 1.0
step = 0.05
size_flags_vertical = 4

[node name="TextSizeRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/TextSizeRow"]
layout_mode = 2
text = "settings.text_size"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="TextSize" type="HSlider" parent="Center/Panel/Column/Scroll/Rows/TextSizeRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)
min_value = 1.0
max_value = 2.0
step = 0.25
value = 1.0
size_flags_vertical = 4

[node name="ReducedMotionRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/ReducedMotionRow"]
layout_mode = 2
text = "settings.reduced_motion"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="ReducedMotion" type="CheckButton" parent="Center/Panel/Column/Scroll/Rows/ReducedMotionRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)

[node name="FullscreenRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2
unique_name_in_owner = true

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/FullscreenRow"]
layout_mode = 2
text = "settings.fullscreen"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="Fullscreen" type="CheckButton" parent="Center/Panel/Column/Scroll/Rows/FullscreenRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)

[node name="LanguageRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/LanguageRow"]
layout_mode = 2
text = "settings.language"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="Language" type="OptionButton" parent="Center/Panel/Column/Scroll/Rows/LanguageRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)

[node name="DifficultyRow" type="HBoxContainer" parent="Center/Panel/Column/Scroll/Rows"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Column/Scroll/Rows/DifficultyRow"]
layout_mode = 2
text = "settings.difficulty"
size_flags_horizontal = 3
custom_minimum_size = Vector2(300, 0)
autowrap_mode = 3

[node name="Difficulty" type="OptionButton" parent="Center/Panel/Column/Scroll/Rows/DifficultyRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 48)

[node name="Back" type="NavButton" parent="Center/Panel/Column"]
layout_mode = 2
text = "menu.back"
action = "back"
