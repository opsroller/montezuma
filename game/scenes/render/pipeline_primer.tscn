[gd_scene load_steps=5 format=3 uid="uid://bmzpipelineprimer"]
; SPDX-License-Identifier: GPL-2.0-or-later
; Turns on, for a frame or two before any asset loads, every rendering
; feature the game uses, so Godot's pipeline precompilation covers them
; (docs/explanation/about-pipeline-compilation.md). ScenePreloader adds it
; and frees it once the scene it loads is in.

[sub_resource type="BoxMesh" id="box"]
size = Vector3(0.1, 0.1, 0.1)

[sub_resource type="StandardMaterial3D" id="sss"]
subsurf_scatter_enabled = true

[sub_resource type="Environment" id="env"]
ssao_enabled = true
ssil_enabled = true
ssr_enabled = true
glow_enabled = true
volumetric_fog_enabled = true

[sub_resource type="CameraAttributesPractical" id="camera"]

[node name="PipelinePrimer" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env")
camera_attributes = SubResource("camera")

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 1)
current = true

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("box")
surface_material_override/0 = SubResource("sss")

[node name="ShadowLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0.5)
shadow_enabled = true
omni_shadow_mode = 0

[node name="ReflectionProbe" type="ReflectionProbe" parent="."]
size = Vector3(1, 1, 1)
