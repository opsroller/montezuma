[configuration]

entry_symbol = "montezuma_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libmontezuma.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmontezuma.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libmontezuma.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libmontezuma.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/libmontezuma.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libmontezuma.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/libmontezuma.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/libmontezuma.windows.template_release.arm64.dll"
macos.debug = "res://bin/libmontezuma.macos.template_debug.universal.dylib"
macos.release = "res://bin/libmontezuma.macos.template_release.universal.dylib"
android.debug.arm64 = "res://bin/libmontezuma.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libmontezuma.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/libmontezuma.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libmontezuma.android.template_release.x86_64.so"
ios.debug = "res://bin/libmontezuma.ios.template_debug.arm64.dylib"
ios.release = "res://bin/libmontezuma.ios.template_release.arm64.dylib"
web.debug.wasm32 = "res://bin/libmontezuma.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libmontezuma.web.template_release.wasm32.nothreads.wasm"
